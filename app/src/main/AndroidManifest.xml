<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.topacademy_android"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".TopAcademyApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Topacademy_android">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Topacademy_android">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>


        <activity android:name=".HomeActivity" />
        <activity android:name=".feature.calculator.presentation.CalculatorActivity" />
        <activity android:name=".feature.cars.presentation.ListActivity" />
        <activity android:name=".feature.weather.presentation.WeatherActivity" />
        <activity android:name=".feature.weather.presentation.WeatherDetailActivity" />
    </application>
</manifest>
