<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextHeadline">
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextCardTitle">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextCost">
        <item name="android:textSize">@dimen/text_cost</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="AppMenuButton" parent="Widget.MaterialComponents.Button">
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/_8dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="CalcKey" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/_8dp</item>
        <item name="android:layout_marginEnd">@dimen/_8dp</item>
        <item name="android:layout_marginTop">@dimen/_8dp</item>
    </style>

    <style name="CarCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/_12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
