<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.topacademy_android.LoginFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.topacademy_android.HomeFragment"
        android:label="@string/app_name">
        <action android:id="@+id/action_homeFragment_to_weatherFragment"
            app:destination="@id/weatherFragment"/>
        <action android:id="@+id/action_homeFragment_to_carsFragment"
            app:destination="@id/carsFragment"/>
        <action android:id="@+id/action_homeFragment_to_calculatorFragment"
            app:destination="@id/calculatorFragment"/>
    </fragment>

    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.example.topacademy_android.feature.weather.presentation.WeatherFragment"
        android:label="@string/title_weather" />

    <fragment
        android:id="@+id/weatherDetailFragment"
        android:name="com.example.topacademy_android.feature.weather.presentation.WeatherDetailFragment"
        android:label="@string/title_weather">

        <argument android:name="date"    app:argType="string" />
        <argument android:name="weather" app:argType="string" />
        <argument android:name="tMax"    app:argType="integer" />
        <argument android:name="tMin"    app:argType="integer" />
        <argument android:name="wind"    app:argType="integer" />
    </fragment>

</navigation>
